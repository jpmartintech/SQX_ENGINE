#property strict
void SQX_TraceEvaluation(string file,datetime evaluation_time,datetime signal_time,int strategy_index,string strategy_id,string direction,bool has_position,double open_risk,int predicate_count,string aggregation,string f1,double v1,double t1,bool b1,string f2,double v2,double t2,bool b2,string f3,double v3,double t3,bool b3,string f4,double v4,double t4,bool b4,bool raw_signal,bool position_gate,string risk_gate,bool concurrent_gate,bool entry_admitted,double requested_risk,double volume,double open_risk_after,string reason){int h=FileOpen(file,FILE_READ|FILE_WRITE|FILE_CSV|FILE_ANSI|FILE_SHARE_READ|FILE_SHARE_WRITE,',');if(h==INVALID_HANDLE)return;if(FileSize(h)==0)FileWrite(h,"evaluation_time","signal_bar_time","strategy_index","strategy_id","direction","has_position_before","open_risk_before","predicate_count","aggregation_mode","predicate_1_id","predicate_1_numeric_value","predicate_1_threshold_or_reference","predicate_1_result","predicate_2_id","predicate_2_numeric_value","predicate_2_threshold_or_reference","predicate_2_result","predicate_3_id","predicate_3_numeric_value","predicate_3_threshold_or_reference","predicate_3_result","predicate_4_id","predicate_4_numeric_value","predicate_4_threshold_or_reference","predicate_4_result","raw_signal","position_gate","risk_gate","concurrent_gate","entry_admitted","requested_risk","volume_if_admitted","open_risk_after","reason_if_rejected");FileSeek(h,0,SEEK_END);FileWrite(h,TimeToString(evaluation_time,TIME_DATE|TIME_SECONDS),TimeToString(signal_time,TIME_DATE|TIME_SECONDS),strategy_index,strategy_id,direction,has_position,open_risk,predicate_count,aggregation,f1,v1,t1,b1,f2,v2,t2,b2,f3,v3,t3,b3,f4,v4,t4,b4,raw_signal,position_gate,risk_gate,concurrent_gate,entry_admitted,requested_risk,volume,open_risk_after,reason);FileClose(h);}
void SQX_TraceRawSignal(string file,datetime signal_time,datetime entry_time,int strategy_index,string strategy_id,string direction,bool has_position,string risk_gate,bool entry_admitted,string reason){int h=FileOpen(file,FILE_READ|FILE_WRITE|FILE_CSV|FILE_ANSI|FILE_SHARE_READ|FILE_SHARE_WRITE,',');if(h==INVALID_HANDLE)return;if(FileSize(h)==0)FileWrite(h,"signal_bar_time","entry_bar_time","strategy_index","strategy_id","direction","has_position","risk_gate","entry_admitted","reason");FileSeek(h,0,SEEK_END);FileWrite(h,TimeToString(signal_time,TIME_DATE|TIME_SECONDS),TimeToString(entry_time,TIME_DATE|TIME_SECONDS),strategy_index,strategy_id,direction,has_position,risk_gate,entry_admitted,reason);FileClose(h);}
